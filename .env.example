# Copie para .env e preencha os valores. Não publique o .env.
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DATABASE_URL=postgresql://labiomec:SUBSTITUA_POR_UMA_SENHA_FORTE@localhost:5432/labiomec
SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
STORAGE_DIR=./var/files
STORAGE_LIMIT_GB=100
MAX_UPLOAD_MB=2048
POST_ATTACHMENT_MAX_MB=250
ALLOW_REGISTRATION=false
# Em produção (HTTPS) use COOKIE_SECURE=true e PUBLIC_ORIGIN com https://. Só 'false' em testes locais.
COOKIE_SECURE=false
# Preencha com a origem HTTPS exata se houver proxy, por exemplo https://hub.exemplo.br
PUBLIC_ORIGIN=
# Recuperação de senha pelo Gmail: ative a verificação em duas etapas e gere uma senha de app.
# Nunca use a senha normal da sua conta Google. Não compartilhe a senha de app no chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Opcional. Vazio usa SMTP_USERNAME como remetente.
SMTP_FROM=
# Salas de voz locais. Gere valores aleatórios para a chave e o segredo.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://voice:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Quantos proxies reversos confiáveis (Nginx, Caddy, Cloudflare...) ficam à frente do app. 0 = nenhum.
# Necessário atrás de proxy para o limite de tentativas enxergar o IP real; com 0 ele ignora X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
# Máximo de envios de arquivos por pessoa por hora.
UPLOADS_PER_HOUR=200
# Gerar segredos fortes: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Optional private Supabase storage (default: local; Vercel: supabase).
# Store real credentials only in .env.cloud or the hosting environment.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hub-files
# For Vercel: STORAGE_BACKEND=supabase, MAX_UPLOAD_MB=4, STORAGE_LIMIT_GB=1,
# POST_ATTACHMENT_MAX_MB=4, COOKIE_SECURE=true and your exact HTTPS PUBLIC_ORIGIN.
# HUB_ENV_FILE=.env.cloud selects private cloud settings for CLI commands.
